  "scenes": [
    {
      "id": "a2e1s1",
      "episodeId": "a2e1",
      "title": "Nummer 34",
      "titleEn": "Number 34",
      "place": "Bürgeramt, Wartebereich",
      "bg": "amt",
      "contextTags": ["admin", "paperwork", "phone"],
      "requiredItems": ["der-termin"],
      "introducedItems": ["das-buergeramt", "der-pass", "das-formular", "die-anmeldung", "ich-habe-einen-termin", "der-schalter"],
      "beats": [
        { "type": "narration", "text": "Kunststoffstühle in Reihen, eine Zahlenanzeige, der Geruch von Kaffee aus einem Automaten. Du bist früh da. Das ist richtig so." },
        { "type": "meet", "itemIds": ["das-buergeramt", "der-pass", "das-formular"] },
        { "type": "line", "speaker": "durchsage-amt", "text": "Nummer dreiunddreißig, bitte an Schalter vier.", "translation": "Number thirty-three, please go to counter four." },
        { "type": "meet", "itemIds": ["die-anmeldung", "ich-habe-einen-termin", "der-schalter"] },
        { "type": "line", "speaker": "herr-bauer", "text": "Guten Morgen. So, Sie sind also die Nummer vierunddreißig. Anmeldung? Dann her mit dem Pass.", "translation": "Good morning. So you're number thirty-four. Registration? Then hand over the passport." },
        { "type": "check", "count": 2, "mode": "mixed" },
        { "type": "choice", "prompt": "Herr Bauer tippt. Dein Pass wandert über den Schalter.", "options": [
          { "label": "Ich habe einen Termin um zehn.", "line": "Ich habe einen Termin um zehn." },
          { "label": "Ist das das richtige Formular?", "line": "Ist das das richtige Formular?" }
        ] },
        { "type": "line", "speaker": "herr-bauer", "text": "Termin hin oder her — Hauptsache, Sie sind da. Das Formular füllen wir gemeinsam aus.", "translation": "Appointment or not — main thing is you're here. We'll fill out the form together." },
        { "type": "check", "count": 2, "mode": "recall" }
      ]
    },
    {
      "id": "a2e1s2",
      "episodeId": "a2e1",
      "title": "Herr Bauer fragt",
      "titleEn": "Herr Bauer asks",
      "place": "Bürgeramt, Schalter 4",
      "bg": "amt",
      "contextTags": ["admin", "paperwork", "identity"],
      "requiredItems": ["die-wohnung"],
      "introducedItems": ["die-adresse", "das-datum", "unterschreiben", "der-beruf", "wo-wohnen-sie", "der-stempel"],
      "beats": [
        { "type": "line", "speaker": "herr-bauer", "text": "So. Wo wohnen Sie?", "translation": "Right. Where do you live?" },
        { "type": "meet", "itemIds": ["wo-wohnen-sie", "die-adresse", "das-datum"] },
        { "type": "choice", "prompt": "Antworte.", "options": [
          { "label": "In der Bärbelstraße 12.", "line": "In der Bärbelstraße 12, zweite Etage." },
          { "label": "Meine Adresse ist neu. Ich schreib sie auf.", "line": "Meine Adresse ist neu. Ich schreibe sie auf." }
        ] },
        { "type": "line", "speaker": "herr-bauer", "text": "Bärbelstraße 12 … gut. Und Ihr Beruf? …„Noch unklar“? Ich schreibe: „Suchend“. Da sind Sie in Leipzig in guter Gesellschaft.", "translation": "Bärbelstraße 12 … good. And your profession? …'Still unclear'? I'll write: 'searching'. You're in good company in Leipzig." },
        { "type": "meet", "itemIds": ["der-beruf", "unterschreiben", "der-stempel"] },
        { "type": "check", "count": 2, "mode": "mixed" },
        { "type": "narration", "text": "Er dreht das Formular zu dir und zeigt mit dem Finger. Eine Zeile, ein Kasten, dein Name." },
        { "type": "line", "speaker": "herr-bauer", "text": "Hier unterschreiben, bitte. …Und jetzt das Wichtigste:", "translation": "Please sign here. …And now the most important part:" },
        { "type": "check", "count": 2, "mode": "listen" },
        { "type": "narration", "text": "Der Stempel kracht auf das Papier wie ein Gongschlag. Es ist vollbracht." }
      ]
    },
    {
      "id": "a2e1s3",
      "episodeId": "a2e1",
      "title": "Die Bestätigung",
      "titleEn": "The confirmation",
      "place": "Bürgeramt, Ausgang & Straße",
      "bg": "strasse",
      "contextTags": ["admin", "paperwork"],
      "requiredItems": ["das-formular"],
      "introducedItems": ["die-bestaetigung", "der-brief", "die-post", "abholen", "in-zwei-wochen", "alles-klar"],
      "beats": [
        { "type": "line", "speaker": "herr-bauer", "text": "Die Bestätigung kommt per Post in zwei Wochen. Sie brauchen sie fürs Bankkonto, für den Vertrag, für alles.", "translation": "The confirmation comes by post in two weeks. You'll need it for the bank account, the contract, everything." },
        { "type": "meet", "itemIds": ["die-bestaetigung", "der-brief", "die-post"] },
        { "type": "meet", "itemIds": ["abholen", "in-zwei-wochen", "alles-klar"] },
        { "type": "choice", "prompt": "Letzte Frage von Herrn Bauer.", "options": [
          { "label": "Alles klar. Danke schön!", "line": "Alles klar. Danke schön!" },
          { "label": "Und wenn der Brief nicht kommt?", "line": "Und wenn der Brief nicht kommt?" }
        ] },
        { "type": "line", "speaker": "herr-bauer", "text": "Dann rufen Sie an. …Oder Sie kommen wieder. — Nächste Person, bitte!", "translation": "Then call. …Or come back again. — Next person, please!" },
        { "type": "check", "count": 2, "mode": "mixed" },
        { "type": "narration", "text": "Draußen: Sonne über dem Ring. Du bist offiziell ein Mensch mit Adresse. Zwei Wochen später liegt der Brief tatsächlich im Briefkasten — du holst ihn ab wie einen Schatz." },
        { "type": "check", "count": 2, "mode": "recall" }
      ]
    }
  ]
}
