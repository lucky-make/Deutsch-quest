  "scenes": [
    {
      "id": "b2e2s1",
      "episodeId": "b2e2",
      "title": "Klare Worte",
      "titleEn": "Clear words",
      "place": "Hausarztpraxis Dr. Kern",
      "bg": "klinik",
      "contextTags": [
        "health",
        "doctor",
        "diagnosis"
      ],
      "requiredItems": [
        "die-praxis",
        "der-termin"
      ],
      "introducedItems": [
        "die-beschwerden",
        "die-diagnose",
        "das-ergebnis",
        "die-belastung",
        "verschreiben",
        "schonen-sie"
      ],
      "beats": [
        {
          "type": "narration",
          "text": "Baustellenwochen, Kaffeekisten, ein falscher Hebelgriff. Die Schulter meldet sich jetzt bei jedem Tassenheben. Dr. Kern misst, drückt, hört zu."
        },
        {
          "type": "meet",
          "itemIds": [
            "die-beschwerden",
            "die-belastung",
            "schonen-sie"
          ]
        },
        {
          "type": "line",
          "speaker": "dr-kern",
          "text": "Also — Ihre Beschwerden passen zu einer Reizung der Sehne. Zu viel Belastung, zu wenig Pausen. Kein Weltuntergang, versprochen.",
          "translation": "Well — your complaints fit an irritation of the tendon. Too much strain, too few breaks. Nothing serious."
        },
        {
          "type": "meet",
          "itemIds": [
            "die-diagnose",
            "das-ergebnis",
            "verschreiben"
          ]
        },
        {
          "type": "choice",
          "prompt": "Sie legt den Stift bereit.",
          "options": [
            {
              "label": "Und für die Arbeit? Ich hebe dort viel.",
              "line": "Und für die Arbeit? Ich hebe dort täglich Kisten."
            },
            {
              "label": "Soll ich die Schulter komplett schonen?",
              "line": "Soll ich die Schulter komplett schonen?"
            }
          ]
        },
        {
          "type": "line",
          "speaker": "dr-kern",
          "text": "Ich verschreibe Ihnen Physiotherapie, sechs Termine. Und eine Woche Krankschreibung für die schweren Sachen. Das Ergebnis kontrollieren wir in zwei Wochen.",
          "translation": "I'll prescribe physiotherapy, six sessions. And a week of sick leave for the heavy lifting. We'll check the result in two weeks."
        },
        {
          "type": "check",
          "count": 2,
          "mode": "mixed"
        },
        {
          "type": "check",
          "count": 2,
          "mode": "recall"
        }
      ]
    },
    {
      "id": "b2e2s2",
      "episodeId": "b2e2",
      "title": "Die Krankschreibung",
      "titleEn": "The sick leave",
      "place": "Wohnung, Telefonat mit der Theke",
      "bg": "wohnung",
      "contextTags": [
        "health",
        "work",
        "sick-leave"
      ],
      "requiredItems": [
        "krank",
        "die-verantwortung"
      ],
      "introducedItems": [
        "die-krankschreibung",
        "vertreten",
        "der-dienstplan",
        "bald-wieder-fit",
        "sich-schonen",
        "die-pause"
      ],
      "beats": [
        {
          "type": "narration",
          "text": "Du liegst mit einer Wärmflasche auf der Schulter und einer Aufgabe: Luise informieren, ohne Drama. Dr. Kerns Zettel liegt neben dem Handy."
        },
        {
          "type": "meet",
          "itemIds": [
            "die-krankschreibung",
            "der-dienstplan",
            "die-pause"
          ]
        },
        {
          "type": "line",
          "speaker": "luise",
          "text": "Eine Woche?! …Nein, Moment: gut, dass du's sagst. Wer vertreibt… wer vertritt dich im Dienstplan? Mei?",
          "translation": "A week?! …No, wait: good that you're telling me. Who covers you on the rota? Mei?"
        },
        {
          "type": "meet",
          "itemIds": [
            "vertreten",
            "sich-schonen",
            "bald-wieder-fit"
          ]
        },
        {
          "type": "choice",
          "prompt": "Luise wartet.",
          "options": [
            {
              "label": "Mei kann mich vertreten, ich kläre das.",
              "line": "Mei kann mich vertreten, ich kläre das mit ihr."
            },
            {
              "label": "Ich schicke dir die Krankschreibung als Foto.",
              "line": "Ich schicke dir gleich ein Foto von der Krankschreibung."
            }
          ]
        },
        {
          "type": "line",
          "speaker": "mei",
          "text": "Alles gut, Chef-Träger. Ich übernehme deinen Samstag. Und jetzt: sich schonen, verstanden? Ich hoffe, du bist bald wieder fit!",
          "translation": "All good, boss-lifter. I'll take your Saturday. And now: take it easy, understood? I hope you're back on your feet soon!"
        },
        {
          "type": "check",
          "count": 2,
          "mode": "mixed"
        },
        {
          "type": "check",
          "count": 2,
          "mode": "listen"
        },
        {
          "type": "narration",
          "text": "Eine Woche Pause. Der Dienstplan läuft ohne dich, die Welt dreht sich weiter — und das ist, stellt sich heraus, der ganze Sinn der Sache."
        }
      ]
    }
  ]
}