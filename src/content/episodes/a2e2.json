  "scenes": [
    {
      "id": "a2e2s1",
      "episodeId": "a2e2",
      "title": "Bewerben bei Luise",
      "titleEn": "Applying with Luise",
      "place": "Café Luise, Nachmittag",
      "bg": "cafe",
      "contextTags": ["work", "job", "cafe"],
      "requiredItems": ["der-kaffee"],
      "introducedItems": ["die-stelle", "ich-bewerbe-mich", "der-lebenslauf", "die-erfahrung", "ich-lerne-schnell", "der-probetag"],
      "beats": [
        { "type": "narration", "text": "Ein Zettel im Fenster von Café Luise: „Suche Hilfe hinter der Theke. Sprechen: nötig. Lächeln: nötig. Perfektion: überbewertet.“" },
        { "type": "meet", "itemIds": ["die-stelle", "ich-bewerbe-mich", "der-lebenslauf"] },
        { "type": "line", "speaker": "luise", "text": "Du? Na super. Ich brauche jemanden ab morgen. Hast du schon mal in der Gastronomie gearbeitet?", "translation": "You? Great. I need someone from tomorrow. Have you ever worked in hospitality?" },
        { "type": "meet", "itemIds": ["die-erfahrung", "ich-lerne-schnell", "der-probetag"] },
        { "type": "choice", "prompt": "Verkaufe dich. Mit Wahrheit.", "options": [
          { "label": "Ich lerne schnell. Und Kaffee mag ich.", "line": "Ich lerne schnell. Und Kaffee mag ich sehr." },
          { "label": "Ehrlich: wenig Erfahrung. Aber Lust.", "line": "Ehrlich gesagt: wenig Erfahrung. Aber Lust." }
        ] },
        { "type": "line", "speaker": "luise", "text": "Lust ist der Anfang von Erfahrung. …Mach einen Probetag. Morgen, acht Uhr. Schürze gibt's hier.", "translation": "Desire is the start of experience. …Do a trial day. Tomorrow, eight a.m. Apron's provided here." },
        { "type": "check", "count": 2, "mode": "mixed" },
        { "type": "check", "count": 2, "mode": "recall" },
        { "type": "narration", "text": "Du gehst mit einem Mittwoch-Termin und einem kleinen Pulsrasen nach Hause. Bewerbung: abgehakt." }
      ]
    },
    {
      "id": "a2e2s2",
      "episodeId": "a2e2",
      "title": "Hinter der Theke",
      "titleEn": "Behind the counter",
      "place": "Café Luise, 8:00 Uhr",
      "bg": "cafe",
      "contextTags": ["work", "cafe", "service"],
      "requiredItems": ["ich-haette-gern", "der-kaffee"],
      "introducedItems": ["die-schuerze", "die-kasse", "der-kunde", "was-darf-es-sein", "die-tasse", "gleich-fertig"],
      "beats": [
        { "type": "line", "speaker": "luise", "text": "Guten Morgen, Probekraft! Schürze schnüren, Hände waschen, Maschine an. …Und lächeln kostet hier nichts.", "translation": "Good morning, trial staff! Tie your apron, wash your hands, machine on. …And smiling costs nothing here." },
        { "type": "meet", "itemIds": ["die-schuerze", "die-kasse", "die-tasse"] },
        { "type": "meet", "itemIds": ["der-kunde", "was-darf-es-sein", "gleich-fertig"] },
        { "type": "line", "speaker": "kunde", "text": "Ich hätte gern einen Kaffee mit Milch und ein Wasser.", "translation": "I'd like a coffee with milk and a water." },
        { "type": "check", "count": 2, "mode": "mixed" },
        { "type": "choice", "prompt": "Dein erster Kunde steht da.", "options": [
          { "label": "Was darf es sein? …Oh — schon gesagt.", "line": "Was darf es sein? …Oh — haben Sie schon gesagt." },
          { "label": "Gleich fertig! Ein Kaffee mit Milch und ein Wasser.", "line": "Gleich fertig! Ein Kaffee mit Milch und ein Wasser." }
        ] },
        { "type": "line", "speaker": "kunde", "text": "Stark, das Tempo! Du machst das ja wie ein Profi.", "translation": "Nice pace! You're doing this like a pro." },
        { "type": "check", "count": 2, "mode": "listen" },
        { "type": "narration", "text": "Um elf Uhr drängelt sich eine ganze Mittagspause durch die Tür. Die Kasse klickt. Luise beobachtet dich über den Milchschaum und nickt langsam." },
        { "type": "check", "count": 2, "mode": "recall" }
      ]
    },
    {
      "id": "a2e2s3",
      "episodeId": "a2e2",
      "title": "Der Vertrag",
      "titleEn": "The contract",
      "place": "Café Luise, hintere Stube",
      "bg": "buero",
      "contextTags": ["work", "money", "paperwork"],
      "requiredItems": ["unterschreiben"],
      "introducedItems": ["der-vertrag", "die-stunde", "der-lohn", "die-unterschrift", "der-feierabend", "herzlich-willkommen-im-team"],
      "beats": [
        { "type": "narration", "text": "Abend. Luise legt einen Bogen Papier auf den Tisch zwischen zwei Kaffeetassen." },
        { "type": "meet", "itemIds": ["der-vertrag", "die-stunde", "der-lohn"] },
        { "type": "line", "speaker": "luise", "text": "Zwölf Euro die Stunde, erst mal zwanzig Stunden die Woche. Kleines Café, kleiner Lohn, aber ehrlich.", "translation": "Twelve euros an hour, twenty hours a week to start. Small café, small wage, but honest." },
        { "type": "meet", "itemIds": ["die-unterschrift", "der-feierabend", "herzlich-willkommen-im-team"] },
        { "type": "choice", "prompt": "Sie schiebt den Vertrag zu dir.", "options": [
          { "label": "Ich unterschreibe. Danke, Luise!", "line": "Ich unterschreibe. Danke, Luise!" },
          { "label": "Darf ich ihn in Ruhe lesen?", "line": "Darf ich ihn in Ruhe lesen?" }
        ] },
        { "type": "line", "speaker": "luise", "text": "Lesen ist gut. Unbedingt lesen. …Und dann: Herzlich willkommen im Team!", "translation": "Reading is good. Definitely read. …And then: a warm welcome to the team!" },
        { "type": "check", "count": 2, "mode": "mixed" },
        { "type": "check", "count": 2, "mode": "recall" },
        { "type": "narration", "text": "Deine Unterschrift, ihr Kaffeefleck, ein Handschlag. Um zwanzig Uhr schaltet Luise das Licht aus: Feierabend. Dein Feierabend." }
      ]
    }
  ]
