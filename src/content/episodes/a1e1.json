  "scenes": [
    {
      "id": "a1e1s1",
      "episodeId": "a1e1",
      "title": "Gleis 7",
      "titleEn": "Platform 7",
      "place": "Hauptbahnhof, Fernbahnhofshalle",
      "bg": "bahnhof",
      "contextTags": ["arrival", "transport"],
      "requiredItems": [],
      "introducedItems": ["der-bahnhof", "das-gleis", "die-fahrkarte", "der-koffer", "entschuldigung", "wo-ist-gleis"],
      "beats": [
        { "type": "narration", "text": "Sechs Stunden Zug. Ein Koffer, in dem zu viel Hoffnung steckt. Über dir kräht eine Stimme aus dem Lautsprecher — und du verstehst zum Glück genau die richtige Hälfte." },
        { "type": "line", "speaker": "ansage", "text": "Der Zug aus Frankfurt kommt heute auf Gleis 7 an.", "translation": "The train from Frankfurt arrives on platform 7 today." },
        { "type": "meet", "itemIds": ["der-bahnhof", "das-gleis", "die-fahrkarte"] },
        { "type": "narration", "text": "Erst mal orientieren. Am Schalter steht ein Mann mit Mütze, der schon tausend Verlorene gerettet hat. Du hörst ein Muster, das du sofort klauen kannst." },
        { "type": "meet", "itemIds": ["der-koffer", "entschuldigung", "wo-ist-gleis"] },
        { "type": "check", "count": 2, "mode": "mixed" },
        { "type": "choice", "prompt": "Der Schalter ist frei. Wie fragst du?", "options": [
          { "label": "Entschuldigung, wo ist Gleis sieben?", "line": "Entschuldigung, wo ist Gleis sieben?" },
          { "label": "Hallo! Bahn? Leipzig? Gleis?", "line": "Hallo! Bahn? Leipzig? Gleis?" }
        ] },
        { "type": "line", "speaker": "mitarbeiter", "text": "Gleis sieben? Da drüben, links. Der Zug fährt gleich.", "translation": "Platform seven? Over there, on the left. The train leaves soon." },
        { "type": "check", "count": 2, "mode": "mixed" },
        { "type": "narration", "text": "Du nickst, lächelst — und hast gerade dein erstes deutsches Gespräch geführt. Der Zug nach Leipzig fährt in zehn Minuten." }
      ]
    },
    {
      "id": "a1e1s2",
      "episodeId": "a1e1",
      "title": "Mit der Straßenbahn",
      "titleEn": "Taking the tram",
      "place": "Vorplatz, Haltestelle Hauptbahnhof",
      "bg": "strasse",
      "contextTags": ["transport", "city"],
      "requiredItems": [],
      "introducedItems": ["die-straßenbahn", "die-haltestelle", "das-ticket", "geradeaus", "faehrt-diese-bahn", "eine-fahrkarte-bitte"],
      "beats": [
        { "type": "narration", "text": "Vor dem Bahnhof: Gleise, Fahrräder überall, ein Kiosk. Die Linie 4 rollt mit leisem Summen heran." },
        { "type": "meet", "itemIds": ["die-straßenbahn", "die-haltestelle", "das-ticket"] },
        { "type": "meet", "itemIds": ["geradeaus", "faehrt-diese-bahn", "eine-fahrkarte-bitte"] },
        { "type": "choice", "prompt": "Automat oder Fahrer?", "options": [
          { "label": "Eine Fahrkarte, bitte.", "line": "Eine Fahrkarte, bitte." },
          { "label": "Ich nehme ein Ticket beim Fahrer.", "line": "Ich nehme ein Ticket." }
        ] },
        { "type": "line", "speaker": "fahrer", "text": "Zwei siebzig. Danke! Zurückbleiben, bitte.", "translation": "Two seventy. Thanks! Please stand back." },
        { "type": "check", "count": 2, "mode": "mixed" },
        { "type": "narration", "text": "Die Bahn ruckt an. Straßennamen ziehen vorbei: Jahnallee, Leutzsch, Lindenau. Du wiederholst sie leise — die Stadt gibt dir kostenlos Vokabeln." },
        { "type": "line", "speaker": "frau-mit-hund", "text": "Aussteigen am Marktplatz? Ich auch! Gleiche Haltestelle.", "translation": "Getting off at Marktplatz? Me too! Same stop." },
        { "type": "check", "count": 2, "mode": "recall" },
        { "type": "narration", "text": "Der Hund seufzt, die Türen zischen auf. Der Marktplatz — dein neues Zentrum der Welt." }
      ]
    },
    {
      "id": "a1e1s3",
      "episodeId": "a1e1",
      "title": "Frau Brügge",
      "titleEn": "Frau Brügge",
      "place": "Bärbelstraße 12, Hauseingang",
      "bg": "wohnung",
      "contextTags": ["arrival", "home", "neighbors"],
      "requiredItems": [],
      "introducedItems": ["die-wohnung", "der-schluessel", "die-vermieterin", "guten-tag", "ich-heisse", "willkommen-in-leipzig"],
      "beats": [
        { "type": "narration", "text": "Bärbelstraße 12. Vor dem Hausflur wartet eine Frau mit kinnlangem Graustich, Arme verschränkt, Blick schon halb freundlich." },
        { "type": "line", "speaker": "frau-bruegge", "text": "Guten Tag! Sie müssen Sam sein. Ich bin Frau Brügge, Ihre Vermieterin.", "translation": "Hello! You must be Sam. I'm Frau Brügge, your landlady." },
        { "type": "meet", "itemIds": ["guten-tag", "die-vermieterin", "ich-heisse"] },
        { "type": "choice", "prompt": "Sie reicht die Hand. Was sagst du?", "options": [
          { "label": "Guten Tag! Ich heiße Sam Jones.", "line": "Guten Tag! Ich heiße Sam Jones." },
          { "label": "Hallo! Sam. …Jones. Also: Sam Jones.", "line": "Hallo! Sam. …Jones. Also: Sam Jones." }
        ] },
        { "type": "meet", "itemIds": ["die-wohnung", "der-schluessel", "willkommen-in-leipzig"] },
        { "type": "line", "speaker": "frau-bruegge", "text": "So. Der Schlüssel. Zweiter Stock, rechts. Die Wohnung ist alt, aber ehrlich.", "translation": "Here. The key. Second floor, on the right. The flat is old, but honest." },
        { "type": "check", "count": 2, "mode": "mixed" },
        { "type": "line", "speaker": "frau-bruegge", "text": "Willkommen in Leipzig! Wenn's Fragen gibt: zweite Etage, Klingelschild „Brügge“.", "translation": "Welcome to Leipzig! If you have questions: second floor, name plate 'Brügge'." },
        { "type": "check", "count": 2, "mode": "recall" },
        { "type": "narration", "text": "Der Schlüssel passt beim ersten Versuch. Die Wohnung ist kalt, leer — und ganz dein." }
      ]
    }
  ]
}
