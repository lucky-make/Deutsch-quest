  "scenes": [
    {
      "id": "a2e4s1",
      "episodeId": "a2e4",
      "title": "Platter Reifen",
      "titleEn": "Flat tire",
      "place": "Elsterflutbecken, Radweg",
      "bg": "park",
      "contextTags": [
        "bike",
        "transport",
        "problem"
      ],
      "requiredItems": [],
      "introducedItems": [
        "das-fahrrad",
        "der-reifen",
        "kaputt",
        "die-werkstatt",
        "mein-fahrrad-ist-kaputt",
        "koennen-sie-mir-helfen"
      ],
      "beats": [
        {
          "type": "narration",
          "text": "Freier Tag, Fahrt an der Elster entlang. Dann: ein Geräusch wie ein genervtes Publikum. Der Hinterreifen liegt flach wie ein Pfannkuchen."
        },
        {
          "type": "meet",
          "itemIds": [
            "das-fahrrad",
            "der-reifen",
            "kaputt"
          ]
        },
        {
          "type": "line",
          "speaker": "tobias",
          "text": "Sam? Was machst du denn hier am Radweg rum? …Oh. Der Reifen ist ja komplett kaputt.",
          "translation": "Sam? What are you doing hanging around the bike path? …Oh. The tire is completely flat."
        },
        {
          "type": "meet",
          "itemIds": [
            "die-werkstatt",
            "mein-fahrrad-ist-kaputt",
            "koennen-sie-mir-helfen"
          ]
        },
        {
          "type": "choice",
          "prompt": "Tobias schaut unbeschwert.",
          "options": [
            {
              "label": "Mein Fahrrad ist kaputt. Hilfe!",
              "line": "Mein Fahrrad ist kaputt. Hilfe!"
            },
            {
              "label": "Ich schiebe es zur Werkstatt. …Irgendwohin.",
              "line": "Ich schiebe es zur Werkstatt. …Irgendwohin."
            }
          ]
        },
        {
          "type": "line",
          "speaker": "tobias",
          "text": "Warte — ich ruf Jonas an. Der ist Handwerker und hat eine Werkstatt im Hinterhof. Kommt gleich!",
          "translation": "Wait — I'll call Jonas. He's a craftsman with a workshop in the back yard. He's coming!"
        },
        {
          "type": "check",
          "count": 2,
          "mode": "mixed"
        },
        {
          "type": "check",
          "count": 2,
          "mode": "recall"
        }
      ]
    },
    {
      "id": "a2e4s2",
      "episodeId": "a2e4",
      "title": "Jonas repariert",
      "titleEn": "Jonas repairs",
      "place": "Jonas' Werkstatt, Hinterhof",
      "bg": "werkstatt",
      "contextTags": [
        "bike",
        "repair",
        "friends"
      ],
      "requiredItems": [
        "kaputt",
        "das-fahrrad"
      ],
      "introducedItems": [
        "das-werkzeug",
        "reparieren",
        "ist-es-fertig",
        "zum-glueck",
        "danke-fuer-deine-hilfe"
      ],
      "beats": [
        {
          "type": "narration",
          "text": "Ein Hinterhof voller Fahrradteile, ein Mann mit Schraubenschlüssel in der Gesäßtasche und Kaffee in der Hand."
        },
        {
          "type": "line",
          "speaker": "jonas",
          "text": "Moin! So, mal gucken … Platten, klar. Fünfzehn Minuten, ich repariere das. Kaffee?",
          "translation": "Hi! Well, let's see … flat tire, clear. Fifteen minutes, I'll repair it. Coffee?"
        },
        {
          "type": "meet",
          "itemIds": [
            "das-werkzeug",
            "reparieren",
            "ist-es-fertig"
          ]
        },
        {
          "type": "meet",
          "itemIds": [
            "zum-glueck",
            "danke-fuer-deine-hilfe"
          ]
        },
        {
          "type": "choice",
          "prompt": "Jonas zieht die Rechnung heraus.",
          "options": [
            {
              "label": "Ist es fertig? Und — was kostet es?",
              "line": "Ist es fertig? Und — was kostet es?"
            },
            {
              "label": "Danke für deine Hilfe! …Wirklich.",
              "line": "Danke für deine Hilfe! …Wirklich."
            }
          ]
        },
        {
          "type": "line",
          "speaker": "jonas",
          "text": "Zehn Euro auf die Rechnung, „Service freundlich“. Zum Glück war nur der Schlauch hin.",
          "translation": "Ten euros on the invoice, 'friendly service'. Luckily only the tube was gone."
        },
        {
          "type": "check",
          "count": 2,
          "mode": "mixed"
        },
        {
          "type": "check",
          "count": 2,
          "mode": "listen"
        },
        {
          "type": "narration",
          "text": "Das Fahrrad rollt wieder. Leipzig hat ganz viele Risse — und ganz viele Leute, die sie just in der Mittagspause zusammennageln."
        }
      ]
    },
    {
      "id": "a2e4s3",
      "episodeId": "a2e4",
      "title": "Der Ausflug zum See",
      "titleEn": "The trip to the lake",
      "place": "Radweg Elsterflutbecken → Cospudener See",
      "bg": "park",
      "contextTags": [
        "bike",
        "friends",
        "leisure"
      ],
      "requiredItems": [
        "das-fahrrad",
        "reparieren"
      ],
      "introducedItems": [
        "der-steg",
        "die-fahrt",
        "der-see",
        "die-luft",
        "sich-ausruhen",
        "froh"
      ],
      "beats": [
        {
          "type": "narration",
          "text": "Eine Woche später: Das Fahrrad läuft wie neu, Jonas hat Luft in die Reifen gepumpt und Tobias hat einen Plan. Der Plan heißt: See."
        },
        {
          "type": "meet",
          "itemIds": [
            "der-steg",
            "die-fahrt",
            "der-see"
          ]
        },
        {
          "type": "line",
          "speaker": "jonas",
          "text": "Kurze Fahrt zum Cospudener See. Zwanzig Minuten, der Wind kommt von hinten, und am Steg gibt's Wasser, Sonne und Leute, die nichts reparieren wollen. Meine Lieblingsmenschen.",
          "translation": "Short ride to Cospuden Lake. Twenty minutes, the wind comes from behind, and at the jetty there's water, sun, and people who don't want anything repaired. My favourite people."
        },
        {
          "type": "meet",
          "itemIds": [
            "die-luft",
            "sich-ausruhen",
            "froh"
          ]
        },
        {
          "type": "check",
          "count": 2,
          "mode": "mixed"
        },
        {
          "type": "choice",
          "prompt": "Am Steg fragt Tobias: „Und? Besser als die Straßenbahn?“",
          "options": [
            {
              "label": "Die Fahrt war schön. Und der See ist besser als Gleis 7.",
              "line": "Die Fahrt war schön. Und der See ist definitiv besser als Gleis 7. …Aber was ist nicht?"
            },
            {
              "label": "Ich bin einfach froh, dass nichts platt ist.",
              "line": "Ich bin einfach froh, dass nichts platt ist. Das ist mein Urlaubsgefühl: funktionierende Reifen."
            }
          ]
        },
        {
          "type": "line",
          "speaker": "jonas",
          "text": "Kurze Fahrt zum Cospudener See. Zwanzig Minuten, der Wind kommt von hinten, und am Steg gibt's Wasser, Sonne und Leute, die nichts reparieren wollen. Meine Lieblingsmenschen.",
          "translation": "Short ride to Cospuden Lake. Twenty minutes, the wind comes from behind, and at the jetty there's water, sun, and people who don't want anything repaired. My favourite people."
        },
        {
          "type": "line",
          "speaker": "tobias",
          "text": "Und jetzt: ausruhen. Ihr wisst, das ist mein Talent. Ich ruhe mich aus wie andere Sport treiben.",
          "translation": "And now: resting. You know that's my talent. I relax the way other people do sports."
        },
        {
          "type": "check",
          "count": 2,
          "mode": "listen"
        },
        {
          "type": "narration",
          "text": "Ihr sitzt am Steg, die Räder liegen im Gras, irgendwo spielt jemand Gitarre. Vor vier Wochen bist du an Gleis 7 gestanden und hast nichts verstanden. Heute verstehst du sogar Jonas' Werkstatt-Witze. Meistens. Die Luft riecht nach Wasser und Sommer — und du bist einfach froh."
        }
      ]
    }
  ]
}