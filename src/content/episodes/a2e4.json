      "beats": [
        {
          "type": "narration",
          "text": "Freier Tag, Fahrt an der Elster entlang. Dann: ein Geräusch wie ein genervtes Publikum. Der Hinterreifen liegt flach wie ein Pfannkuchen."
        },
        {
          "type": "meet",
          "itemIds": [
            "das-fahrrad",
            "der-reifen",
            "kaputt"
          ]
        },
        {
          "type": "line",
          "speaker": "tobias",
          "text": "Sam? Was machst du denn hier am Radweg rum? …Oh. Der Reifen ist ja komplett kaputt.",
          "translation": "Sam? What are you doing hanging around the bike path? …Oh. The tire is completely flat."
        },
        {
          "type": "meet",
          "itemIds": [
            "die-werkstatt",
            "mein-fahrrad-ist-kaputt",
            "koennen-sie-mir-helfen"
          ]
        },
        {
          "type": "choice",
          "prompt": "Tobias schaut unbeschwert.",
          "options": [
            {
              "label": "Mein Fahrrad ist kaputt. Hilfe!",
              "line": "Mein Fahrrad ist kaputt. Hilfe!"
            },
            {
              "label": "Ich schiebe es zur Werkstatt. …Irgendwohin.",
              "line": "Ich schiebe es zur Werkstatt. …Irgendwohin."
            }
          ]
        },
        {
          "type": "line",
          "speaker": "tobias",
          "text": "Warte — ich ruf Jonas an. Der ist Handwerker und hat eine Werkstatt im Hinterhof. Kommt gleich!",
          "translation": "Wait — I'll call Jonas. He's a craftsman with a workshop in the back yard. He's coming!"
        },
        {
          "type": "check",
          "count": 2,
          "mode": "mixed"
        },
        {
          "type": "check",
          "count": 2,
          "mode": "recall"
        }
      ]
    },
    {
      "id": "a2e4s2",
      "episodeId": "a2e4",
      "title": "Jonas repariert",
      "titleEn": "Jonas repairs",
      "place": "Jonas' Werkstatt, Hinterhof",
      "bg": "werkstatt",
      "contextTags": [
        "bike",
        "repair",
