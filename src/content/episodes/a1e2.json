  "scenes": [
    {
      "id": "a1e2s1",
      "episodeId": "a1e2",
      "title": "Zwei Zimmer, Küchenzeile",
      "titleEn": "Two rooms, a kitchenette",
      "place": "Bärbelstraße 12, 2. OG",
      "bg": "wohnung",
      "contextTags": [
        "home",
        "furniture"
      ],
      "requiredItems": [],
      "introducedItems": [
        "das-zimmer",
        "das-bett",
        "der-tisch",
        "das-fenster",
        "wo-ist-die-kueche",
        "die-wohnung-ist-schoen"
      ],
      "beats": [
        {
          "type": "narration",
          "text": "Zwei Zimmer, Küchenzeile, Bad. Im Inserat stand „charmant“. Jetzt heißt das Wort: du wohnst hier."
        },
        {
          "type": "meet",
          "itemIds": [
            "das-zimmer",
            "das-bett",
            "der-tisch"
          ]
        },
        {
          "type": "narration",
          "text": "Aus dem Flur ruft eine Stimme. Ein junger Mann steht in der Tür, einen Karton mit Gläsern im Arm."
        },
        {
          "type": "line",
          "speaker": "tobias",
          "text": "Hallo! Tobias, von gegenüber, dritter Stock. Ich hab ein Regal übrig, falls du eins brauchst. …Und eine Bohrmaschine.",
          "translation": "Hi! Tobias, from across the hall, third floor. I have a spare shelf if you need one. …And a drill."
        },
        {
          "type": "meet",
          "itemIds": [
            "das-fenster",
            "wo-ist-die-kueche",
            "die-wohnung-ist-schoen"
          ]
        },
        {
          "type": "choice",
          "prompt": "Tobias: „Und, was sagst du zur Wohnung?“",
          "options": [
            {
              "label": "Die Wohnung ist schön!",
              "line": "Die Wohnung ist schön!"
            },
            {
              "label": "Wo ist die Küche? …Ah. Da.",
              "line": "Wo ist die Küche? …Ah. Da ist sie."
            }
          ]
        },
        {
          "type": "check",
          "count": 2,
          "mode": "mixed"
        },
        {
          "type": "line",
          "speaker": "tobias",
          "text": "Alte Wohnung, neue Fenster. Nachts hört man nur die Straßenbahn. Gewöhnst du dich dran, versprochen.",
          "translation": "Old flat, new windows. At night you only hear the tram. You'll get used to it, promise."
        },
        {
          "type": "check",
          "count": 2,
          "mode": "recall"
        },
        {
          "type": "reading",
          "title": "Frau Brügges Möbelliste",
          "text": "ZIMMER 1 (für Sam):\n— Bett (klingt komisch, hält 30 Jahre)\n— Tisch von meiner Tante (stabil, ehrlich)\n— Fenster bleibt offen im Sommer, NOTIZ AN MICH: Fliegen\n\nRest steht im Keller.\nWas fehlt, wird gekauft. Mit Liste.\nListe ist bei mir.",
          "translation": "ROOM 1 (for Sam):\n— Bed (sounds strange, lasts 30 years)\n— Table from my aunt (stable, honest)\n— Window stays open in summer, NOTE TO SELF: flies\n\nThe rest is in the basement.\nWhatever's missing will be bought. With a list.\nThe list is with me.",
          "itemIds": [
            "das-zimmer",
            "das-bett",
            "die-wohnung-ist-schoen"
          ]
        },
        {
          "type": "narration",
          "text": "Das Bett steht am Fenster. Erster Abend in Leipzig. Die Decke riecht noch nach dem Zug."
        }
      ]
    },
    {
      "id": "a1e2s2",
      "episodeId": "a1e2",
      "title": "Beim Bäcker",
      "titleEn": "At the bakery",
      "place": "Bäckerei Wenzel, Jahnallee",
      "bg": "laden",
      "contextTags": [
        "food",
        "shopping",
        "request"
      ],
      "requiredItems": [],
      "introducedItems": [
        "das-brot",
        "die-butter",
        "der-apfel",
        "das-wasser",
        "ich-haette-gern",
        "zusammen-bitte"
      ],
      "beats": [
        {
          "type": "narration",
          "text": "Sonntagmorgen. Die Jahnallee riecht nach Brötchen. In der Bäckerei Wenzel stehen vier Leute an — alle reden Deutsch. Alle."
        },
        {
          "type": "meet",
          "itemIds": [
            "das-brot",
            "die-butter",
            "der-apfel"
          ]
        },
        {
          "type": "line",
          "speaker": "verkaeuferin",
          "text": "Guten Morgen! Und für Sie?",
          "translation": "Good morning! And for you?"
        },
        {
          "type": "meet",
          "itemIds": [
            "das-wasser",
            "ich-haette-gern",
            "zusammen-bitte"
          ]
        },
        {
          "type": "choice",
          "prompt": "Du bist dran.",
          "options": [
            {
              "label": "Ich hätte gern ein Brötchen und ein Wasser.",
              "line": "Ich hätte gern ein Brötchen und ein Wasser."
            },
            {
              "label": "Ein Brot, bitte. …Und Butter.",
              "line": "Ein Brot, bitte. …Und Butter."
            }
          ]
        },
        {
          "type": "line",
          "speaker": "verkaeuferin",
          "text": "Sehr gern. Sonst noch etwas? — Zusammen macht drei vierzig.",
          "translation": "With pleasure. Anything else? — Together that's three forty."
        },
        {
          "type": "check",
          "count": 2,
          "mode": "mixed"
        },
        {
          "type": "narration",
          "text": "Mit der Tüte auf dem Arm gehst du zurück. Das Brot ist noch warm. Leipzig kann also was."
        },
        {
          "type": "check",
          "count": 2,
          "mode": "recall"
        }
      ]
    },
    {
      "id": "a1e2s3",
      "episodeId": "a1e2",
      "title": "Möbel mit Tobias",
      "titleEn": "Furniture with Tobias",
      "place": "Wohnung, 2. OG",
      "bg": "wohnung",
      "contextTags": [
        "home",
        "furniture",
        "neighbors"
      ],
      "requiredItems": [],
      "introducedItems": [
        "der-stuhl",
        "die-lampe",
        "das-regal",
        "der-hammer",
        "ich-helfe-dir",
        "danke-schoen"
      ],
      "beats": [
        {
          "type": "narration",
          "text": "Ein Karton Regalbretter, zwölf Schrauben, null Anleitung. Tobias kommt mit einer Werkzeugkiste die Treppe hoch."
        },
        {
          "type": "line",
          "speaker": "tobias",
          "text": "Anleitung? Hab ich nie benutzt. Ich helfe dir!",
          "translation": "Instructions? Never used one. I'll help you!"
        },
        {
          "type": "meet",
          "itemIds": [
            "der-stuhl",
            "die-lampe",
            "das-regal"
          ]
        },
        {
          "type": "meet",
          "itemIds": [
            "der-hammer",
            "ich-helfe-dir",
            "danke-schoen"
          ]
        },
        {
          "type": "choice",
          "prompt": "Er überreicht dir den Hammer wie einen Worcesters.",
          "options": [
            {
              "label": "Danke schön, Tobias!",
              "line": "Danke schön, Tobias!"
            },
            {
              "label": "Ich helfe dir dann beim Umzug. …Irgendwann.",
              "line": "Ich helfe dir dann beim Umzug. …Irgendwann."
            }
          ]
        },
        {
          "type": "line",
          "speaker": "tobias",
          "text": "Abgemacht! …Moment. Der Stuhl wackelt. Hammer.",
          "translation": "Deal! …Wait. The chair wobbles. Hammer."
        },
        {
          "type": "check",
          "count": 2,
          "mode": "mixed"
        },
        {
          "type": "narration",
          "text": "Zwei Stunden später steht das Regal. Schief, aber es steht. Die Lampe macht warmes Licht auf den alten Dielen."
        },
        {
          "type": "check",
          "count": 2,
          "mode": "recall"
        },
        {
          "type": "line",
          "speaker": "tobias",
          "text": "Wenn du Bock hast: Donnerstag spielen wir in Connewitz. Komm doch mit!",
          "translation": "If you're up for it: Thursday we're playing in Connewitz. Come along!"
        },
        {
          "type": "reading",
          "title": "Aufbauanleitung: Regal „LEP-2000“",
          "text": "1. Teile zählen: 8 Bretter, 16 Schrauben, 1 Hammer.\n2. Kurzes Brett oben. Lange Bretter unten. (Physik.)\n3. Schrauben fest — aber nicht zu fest. (Erfahrung.)\n4. Fertig? Regal schief? → Zweite Person hilft.\n\nHinweis: Das Regal ist gerade.\nDie Wand ist schief. Willkommen im Altbau.",
          "translation": "1. Count the parts: 8 boards, 16 screws, 1 hammer.\n2. Short board on top. Long boards at the bottom. (Physics.)\n3. Tighten the screws — but not too tight. (Experience.)\n4. Done? Shelf crooked? → A second person helps.\n\nNote: the shelf is straight.\nThe wall is crooked. Welcome to old buildings.",
          "itemIds": [
            "das-regal",
            "der-hammer",
            "ich-helfe-dir"
          ]
        }
      ]
    }
  ]
}